# Copy to .env.production on the server. Never commit the real file.
# Used via: docker compose --env-file .env.production up -d --build
POSTGRES_USER=ascard
POSTGRES_PASSWORD=
POSTGRES_DB=ascard

# Generate with: openssl rand -base64 48
JWT_SECRET=
CORS_ORIGINS=

# For the one-off seed command
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
