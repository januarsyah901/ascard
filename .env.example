# ---- Local development (npm run dev:all) ----
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ascard?schema=public"
# Generate with: openssl rand -base64 48   (min. 32 characters)
JWT_SECRET=""
PORT=5001
# Only needed if the frontend runs on a different origin than the API
CORS_ORIGINS=""
# Optional: point the frontend at a separate API host (empty = same origin)
VITE_API_URL=""

# Used by `npm run seed` to create the first admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
